# Policy: No Ad Interference
#
# This package MUST NOT:
# - Call Meta Marketing API write endpoints
# - Call Google Ads mutate / campaign update APIs
# - Call LinkedIn/TikTok campaign APIs
# - Auto-change Stripe prices or Live Mode keys
# - Auto-deploy pricing page changes without human approval
#
# Allowed:
# - Read GA4 / BigQuery analytics exports
# - Import offline CSV exports FROM ad platforms (archives)
# - Generate advisory recommendations + Slack/Sheets reports
# - Scrape public competitor landing pages (polite, scheduled)

AD_PLATFORM_WRITE_ENABLED=false
AUTO_APPLY_PRICE_CHANGES=false
STRIP_MODE_TOUCH_ENABLED=false
