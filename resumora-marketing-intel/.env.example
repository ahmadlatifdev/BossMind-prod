# Copy to .env — NEVER commit .env
# GCP
GCP_PROJECT_ID=resumora-live
GCP_REGION=us-central1
BQ_DATASET=resumora_mkt_intel
GCS_BUCKET_RAW=resumora-mkt-intel-raw
GCS_BUCKET_MODELS=resumora-mkt-intel-models
GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa-marketing-intel.json

# Gemini (Vertex) — cost optimized
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_USE_BATCH=true
BRAND_SCRAPE_MAX_PAGES=8

# Own site (read-only messaging baseline)
OWN_SITE_URL=https://resumora.net
OWN_PRICING_URL=https://resumora.net/pricing

# Competitors (comma-separated landing URLs)
COMPETITOR_URLS=https://www.example-competitor.com/pricing

# Alerts (optional)
SLACK_WEBHOOK_URL=
ENABLE_SLACK_ALERTS=false

# Sheets (optional weekly export)
GOOGLE_SHEETS_SPREADSHEET_ID=
ENABLE_SHEETS_EXPORT=false

# Safety locks — do not change unless Ahmed approves
AD_PLATFORM_WRITE_ENABLED=false
AUTO_APPLY_PRICE_CHANGES=false
STRIP_MODE_TOUCH_ENABLED=false

# Local paths
SAMPLE_CSV_DIR=./samples/csv
MODEL_ARTIFACT_DIR=./artifacts/models
LOG_LEVEL=INFO
