# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.

project_id         = "resumora-live"
billing_account_id = "XXXXXX-XXXXXX-XXXXXX" # required if enable_budget_alert = true
region             = "us-central1"
zone               = "us-central1-a"
environment        = "dev"
budget_amount_usd  = 50
enable_budget_alert = false

bigquery_dataset_name          = "resumora_mkt_intel"
bigquery_table_expiration_days = 90

cloud_run_service_name = "resumora-mkt-intel-dash"
# Build first: gcloud builds submit --tag gcr.io/resumora-live/resumora-mkt-intel:latest
cloud_run_image        = "" # e.g. "gcr.io/resumora-live/resumora-mkt-intel:latest"
enable_public_dashboard = false
enable_scheduler        = true
scheduler_timezone      = "America/Toronto"
