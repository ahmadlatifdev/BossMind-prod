{
  "name": "resumora-luxury",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node -e \"const fs=require('fs');fs.mkdirSync('.next',{recursive:true});fs.writeFileSync('.next/lock','');\"",
    "start": "next start",
    "lint": "eslint .",
    "marketing:weekly-executive": "node scripts/marketing/weekly-executive-schedule.mjs",
    "marketing:weekly-executive:run": "node scripts/marketing/weekly-executive-schedule.mjs --orchestrate",
    "test": "node --test tests/smoke.test.js tests/password-reset.test.js tests/chat-continuity-phase2.test.js",
    "monitor:uptime": "node scripts/monitoring/check-uptime.mjs",
    "audit:fix": "npm audit fix",
    "verify:checkout": "node scripts/verify-checkout-readiness.mjs http://localhost:3000",
    "deploy:hosting": "echo ERROR: Use npm run release:production:v2 for production deploy && exit 1",
    "deploy:client": "echo ERROR: Use npm run release:production:v2 && exit 1",
    "deploy:client:unsafe": "node scripts/guard-controlled-hosting-deploy.mjs",
    "release:production:v2": "node scripts/release-production-v2.mjs",
    "release:production:v2:local": "node scripts/release-production-v2.mjs --skip-deploy"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@aws-sdk/client-cloudwatch": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@edwinfom/resume-intel": "^0.2.1",
    "@google-cloud/error-reporting": "^3.0.6",
    "@google-cloud/logging": "^11.3.0",
    "@langchain/langgraph": "^1.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/stripe-js": "^9.7.0",
    "ai": "^6.0.193",
    "aws-xray-sdk": "^3.12.0",
    "aws-xray-sdk-core": "^3.12.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "formidable": "^3.5.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "ollama": "^0.6.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
