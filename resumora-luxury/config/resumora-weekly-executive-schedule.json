{
  "version": 1,
  "timezone": "America/Toronto",
  "publishUtcHour": 14,
  "slots": [
    {
      "weekday": "Monday",
      "weekdayIndex": 1,
      "theme": "client_testimonial_success_story",
      "platforms": ["linkedin", "facebook"],
      "contentType": "testimonial"
    },
    {
      "weekday": "Wednesday",
      "weekdayIndex": 3,
      "theme": "resume_tip_industry_insight",
      "platforms": ["x", "instagram"],
      "contentType": "insight"
    },
    {
      "weekday": "Friday",
      "weekdayIndex": 5,
      "theme": "call_to_action_promotion",
      "platforms": ["linkedin", "threads"],
      "contentType": "cta"
    }
  ],
  "integrations": {
    "n8n": {
      "webhookEnv": "N8N_SOCIAL_WEBHOOK_URL",
      "enabled": false
    },
    "nativeEngine": {
      "script": "scripts/marketing/run-social-growth-engine.mjs",
      "apiRoute": "/api/integrations/social-growth-orchestrate"
    }
  },
  "notes": "Activate via Railway/cron or: npm run marketing:weekly-executive. Requires NEON_DATABASE_URL + SOCIAL_AUTOMATION_TOKEN for publish."
}
