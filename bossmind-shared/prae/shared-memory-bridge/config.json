{
  "schema": "bossmind-prae-shared-memory-bridge/v1",
  "version": 1,
  "hubRoot": "D:/BossMind",
  "praeRoot": "D:/BossMind/bossmind-shared/prae",
  "bridgeRoot": "D:/BossMind/bossmind-shared/prae/shared-memory-bridge",
  "globalLedgerRoot": "D:/BossMind/bossmind-shared/prae/global-ledger",
  "sharedMemoryRoot": "D:/BossMind/13-shared-memory",
  "masterEnvPath": "D:/BossMind/.env.master.local",
  "lockedInterfacesPath": "D:/BossMind/13-shared-memory/locked-interfaces.json",
  "coreRule": "NO_DIRECT_EXECUTION",
  "praeAuthority": "PRAE_ONLY",
  "security": {
    "blockForceDeployment": true,
    "blockBaselineReset": true,
    "blockUnsafeRepairLoops": true,
    "blockDirectProductionMutation": true,
    "blockUnauthorizedOrchestrationOverride": true,
    "blockAutomaticUiOverwrite": true,
    "blockAutoRepair": true,
    "blockRestoreSeal": true
  },
  "governanceInheritance": {
    "PRAE_GOVERNANCE_MODE": "LOCKED",
    "PRAE_DEPLOYMENT_MODE": "STAGED",
    "PRAE_UI_LOCK": "ENABLED",
    "PRAE_PRODUCTION_MUTATION": "BLOCKED",
    "PRAE_AUTO_REPAIR": "DISABLED",
    "PRAE_AUTHORITY": "PRAE_ONLY",
    "PRAE_RESTORE_SEAL": "DISABLED",
    "PRAE_AUTONOMOUS_MUTATION": "RESTRICTED"
  },
  "projects": [
    { "project_id": "resumora", "root": "D:/BossMind/bossmind-resumora" },
    { "project_id": "elegancyart", "root": "D:/BossMind/bossmind-elegancyart" },
    { "project_id": "ai-video-generator", "root": "D:/BossMind/bossmind-ai-video-generator" },
    { "project_id": "tiktok-ai", "root": "D:/BossMind/bossmind-tiktok-ai" },
    { "project_id": "global-stock", "root": "D:/BossMind/bossmind-global-stock" },
    { "project_id": "bossmind-shared", "root": "D:/BossMind/bossmind-shared" },
    { "project_id": "master-admin", "root": "D:/BossMind/bossmind-master-admin" }
  ],
  "authorityFiles": [
    "authority/prae-runtime-validation.json",
    "deployment-validation/prae-deployment-authority.json",
    "drift-detection/prae-drift-authority.json",
    "repair-simulation/prae-repair-authority.json",
    "checksums/prae-checksum-registry.json"
  ],
  "ledgerPaths": {
    "globalEvents": "global-ledger/governance-events.jsonl",
    "runtimeEvents": "runtime-ledger/prae-events.log",
    "runtimeLedger": "runtime-ledger/prae-runtime-ledger.json",
    "sharedMemoryJsonl": "../automation/logs/shared_memory.jsonl",
    "bridgeLatest": "../../13-shared-memory/prae-bridge-latest.json"
  },
  "deploymentGates": [
    "checksum_validation",
    "runtime_validation",
    "webhook_validation",
    "ui_lock_validation",
    "prae_governance_validation"
  ],
  "productionValidationUrls": {
    "resumora": [
      "https://www.resumora.net/api/health",
      "https://www.resumora.net/api/stripe/webhook-health",
      "https://www.resumora.net/api/runtime/database-health"
    ]
  }
}
